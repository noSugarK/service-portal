[Unit]
Description=Local web service discovery portal
After=network.target

[Service]
Type=simple
User=service-portal
Group=service-portal
WorkingDirectory=/opt/service-portal
ExecStart=/usr/bin/python3 /opt/service-portal/portal.py --config /etc/service-portal/config.json
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/service-portal/docker.env
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
